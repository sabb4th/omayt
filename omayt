            if key == "TAB":
                search_filter = next_search_filter(search_filter)
                continue
            if key in ("ALT_F", "CTRL_F"):
                picked = self._prompt_search_filter(search_filter)
                if picked is not None:
                    search_filter = picked
                continue
            if key == "ENTER":
                chosen = recent[hist_idx] if (0 <= hist_idx < len(recent)) else query.strip()
                if chosen:
                    return (chosen, search_filter)
                if music_mode:
                    # Allows opening music mode directly with the current list/history if empty
                    return ("", search_filter)
                continue
            if key == "DOWN" and recent:
                hist_idx = min(len(recent) - 1, hist_idx + 1)
                continue
            if key == "UP" and recent:
                hist_idx = max(-1, hist_idx - 1)
                continue
            if key == "CTRL_U":
                query = ""
                hist_idx = -1
                continue
            if key == "BACKSPACE":
                hist_idx = -1
                query = query[:-1]
                continue
            if len(key) == 1 and key.isprintable():
                hist_idx = -1
                query += key

