def choose_search_filter_tui(current_filter: str = "all") -> str | None:
    """Opens the Omarchy search filter picker modal (with styled fzf fallback)."""
    active = normalize_search_filter(current_filter)
    modal = OmarchyMainMenu()
    if modal._enter_screen():
        try:
            return modal._prompt_search_filter(active)
        finally:
            modal._leave_screen()

    if not shutil.which("fzf"):
        return None
    c_acc = THEME.ansi_fg("accent", bold=True)
    c_grn = THEME.ansi_fg("green", bold=True)
    c_yel = THEME.ansi_fg("yellow", bold=True)
    c_fg = THEME.ansi_fg("foreground")
    rst = THEME.reset
    rows: list[str] = []
    for flt in SEARCH_FILTERS:
        fid = flt["id"]
        mark = f"{c_grn}✓{rst}" if fid == active else " "
        rows.append(
            f"{fid}\t{mark} {c_yel}[{flt['key']}]{rst} {c_acc}{flt['icon']}{rst}  {c_fg}{get_search_filter_label(fid)}{rst}"
        )
    fzf_env = _subproc_env()
    fzf_env["SHELL"] = "/bin/sh"
    proc = subprocess.run(
        [
            "fzf",
            "--ansi",
            "--layout=reverse",
            "--height=60%",
            "--border=rounded",
            f"--border-label= 󰈲 {tr('Search Filter', 'Filtre de recherche', 'Filtro de pesquisa')} ",
            "--delimiter=\t",
            "--with-nth=2..",
            f"--prompt=󰈲 {tr('Filter', 'Filtre', 'Filtro')} > ",
            THEME.fzf_color_arg(),
        ],
        input="\n".join(rows),
        stdout=subprocess.PIPE,
        text=True,
        env=fzf_env,
    )
    if proc.returncode != 0 or not proc.stdout.strip():
        return None
    return normalize_search_filter(proc.stdout.splitlines()[0].split("\t", 1)[0])


