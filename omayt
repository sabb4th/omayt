    def _selectable_indices(self, items: list[dict[str, Any]]) -> list[int]:
        return [i for i, it in enumerate(items) if it.get("id") != "divider"]

    def _gradient_color_at(self, t: float, bold: bool = True) -> str:
        stops = [
            THEME.rgb("cyan"),
            THEME.rgb("blue"),
            THEME.rgb("accent"),
            THEME.rgb("magenta"),
            THEME.rgb("red"),
            THEME.rgb("yellow"),
            THEME.rgb("cyan"),
        ]
        t = t % 1.0
        n_seg = len(stops) - 1
        seg_f = t * n_seg
        idx = min(int(seg_f), n_seg - 1)
        local_t = seg_f - idx
        r, g, b = THEME.blend_rgb(stops[idx], stops[idx + 1], local_t)
        return THEME.ansi_rgb(r, g, b, bold=bold)

    def _render_logo_lines(self, phase: float, cols: int) -> list[str]:
        rst = THEME.reset
        rendered: list[str] = []
        logo_w = len(OMAYT_ASCII_LOGO[0])
        pad = " " * max(0, (cols - logo_w) // 2)

        for r_idx, line in enumerate(OMAYT_ASCII_LOGO):
            parts: list[str] = [pad]
            for c_idx, ch in enumerate(line):
                if ch == " ":
                    parts.append(" ")
                else:
                    # Smooth diagonal gradient animated by the active Omarchy theme
                    t = (c_idx / max(1, logo_w)) * 0.65 + (r_idx / 6.0) * 0.25 - phase * 0.16
                    parts.append(f"{self._gradient_color_at(t, bold=True)}{ch}")
            parts.append(rst)
            rendered.append("".join(parts))
        return rendered

    def _render_mini_eq(self, phase: float, reverse: bool = False) -> str:
        blocks = ("▁", "▂", "▃", "▄", "▅", "▆", "▇", "█")
        rst = THEME.reset
        bars: list[str] = []
        for i in range(4):
            idx = (3 - i) if reverse else i
            wave = (math.sin(phase * 3.2 + idx * 0.9) + 1.0) * 0.5
            level = min(len(blocks) - 1, max(0, int(wave * (len(blocks) - 1) + 0.35)))
            col = self._gradient_color_at((idx / 4.0) * 0.5 + phase * 0.08, bold=True)
            bars.append(f"{col}{blocks[level]}")
        return "".join(bars) + rst

    @staticmethod
    def _box_top(inner_w: int, left_title: str, right_title: str, border_col: str) -> str:
        rst = THEME.reset
        vl = visible_len(left_title)
        vr = visible_len(right_title)
        if right_title and (inner_w - vl - vr - 4) >= 2:
            dashes = inner_w - vl - vr - 4
            return (
                f"{border_col}╭─ {rst}{left_title}{border_col} {'─' * dashes} "
                f"{rst}{right_title}{border_col} ─╮{rst}"
            )
        dashes = max(1, inner_w - vl - 1)
        return f"{border_col}╭─ {rst}{left_title}{border_col} {'─' * dashes}╮{rst}"

    @staticmethod
    def _box_div(inner_w: int, border_col: str) -> str:
        return f"{border_col}├{'─' * (inner_w + 2)}┤{THEME.reset}"

    @staticmethod
    def _box_bot(inner_w: int, border_col: str) -> str:
        return f"{border_col}╰{'─' * (inner_w + 2)}╯{THEME.reset}"

    @staticmethod
    def _box_line(content: str, inner_w: int, border_col: str, bg: str = "") -> str:
        rst = THEME.reset
        vlen = visible_len(content)
        pad = " " * max(0, inner_w - vlen)
        return f"{border_col}│{rst}{bg} {content}{pad} {rst}{border_col}│{rst}"

    def _render_main_frame(self, items: list[dict[str, Any]]) -> None:
        term = shutil.get_terminal_size((100, 32))
        cols, rows = max(54, term.columns), max(16, term.lines)
        phase = time.time() - self.start_time

        c_acc = THEME.ansi_fg("accent", bold=True)
        c_fg = THEME.ansi_fg("foreground", bold=True)
        c_txt = THEME.ansi_fg("light_foreground")
        c_yel = THEME.ansi_fg("yellow", bold=True)
        c_grn = THEME.ansi_fg("green", bold=True)
        c_mag = THEME.ansi_fg("magenta", bold=True)
        c_cyn = THEME.ansi_fg("cyan", bold=True)
        c_red = THEME.ansi_fg("red", bold=True)
        c_mut = THEME.ansi_fg("muted")
        c_dfg = THEME.ansi_fg("dark_foreground")
        rst = THEME.reset

        # Soft background for the selected row (Omarchy theme blend)
        sel_rgb = THEME.blend_rgb(THEME.rgb("lighter_background"), THEME.rgb("accent"), 0.16)
        bg_sel = THEME.ansi_rgb_bg(*sel_rgb)

        card_total_w = max(52, min(cols - 4, 76))
        inner_w = card_total_w - 4
        left_margin = " " * max(0, (cols - card_total_w) // 2)

        watch_hist = load_json_file(HISTORY_FILE, [])
        search_hist = load_json_file(SEARCH_HIST_FILE, [])

        show_big_logo = rows >= 27 and cols >= 54
        show_pills = rows >= 23
        show_recent_bar = rows >= 25 and bool(search_hist)

        lines_buf: list[str] = []

        # 1. Header / Logo
        if show_big_logo:
            lines_buf.extend(self._render_logo_lines(phase, cols))
            eq_l = self._render_mini_eq(phase, reverse=False)
            eq_r = self._render_mini_eq(phase, reverse=True)
            subtitle = (
                f"{eq_l}  {c_red}󰗃{rst}  {c_fg}OMARCHY YOUTUBE TUI{rst} "
                f"{c_mut}•{rst} {c_cyn}v{APP_VERSION}{rst}  {eq_r}"
            )
            sub_pad = " " * max(0, (cols - visible_len(subtitle)) // 2)
            lines_buf.append(f"{sub_pad}{subtitle}")
        else:
            compact_hdr = (
                f"{c_red}󰗃{rst}  {c_acc}omayt{rst} {c_mut}•{rst} "
                f"{c_fg}Omarchy YouTube TUI{rst} {c_cyn}v{APP_VERSION}{rst}"
            )
            c_pad = " " * max(0, (cols - visible_len(compact_hdr)) // 2)
            lines_buf.append(f"{c_pad}{compact_hdr}")

        # 2. Status bar (Pills)
        if show_pills:
            pills = (
                f"{c_mag}󰏘 {THEME.name}{rst}  {c_mut}│{rst}  "
                f"{c_grn}󰍛 VA-API{rst}  {c_mut}│{rst}  "
                f"{c_cyn}󰒃 Anti-403{rst}  {c_mut}│{rst}  "
                f"{c_yel}󰋚 {len(watch_hist)} " + tr("in history", "dans l’historique", 'no histórico') + f"{rst}"
            )
            p_pad = " " * max(0, (cols - visible_len(pills)) // 2)
            lines_buf.append(f"{p_pad}{pills}")

        lines_buf.append("")

        # 3. Main Menu card
        border_col = THEME.ansi_fg("accent")
        dim_border = THEME.ansi_fg("muted")
        top_left = f"{c_acc}󰕧 {tr('Main Menu', 'Menu principal', 'Menu principal')}{rst}"
        top_right = (
            f"{c_mut}{tr('HD Sixel • Cava', 'Sixel HD • Cava', 'Sixel HD • Cava')}{rst}"
            if inner_w >= 58
            else ""
        )
        lines_buf.append(left_margin + self._box_top(inner_w, top_left, top_right, border_col))

        selected_desc = ""
        for idx, item in enumerate(items):
            if item.get("id") == "divider":
                lines_buf.append(left_margin + self._box_div(inner_w, dim_border))
                continue

            is_sel = idx == self.selected
            key_lbl = item["key"]
            icon = item["icon"]
            color_key = item["color"]
            label = item["label"]
            badge = item["badge"]

            if is_sel:
                selected_desc = item["desc"]
                fg_icon = THEME.ansi_fg(color_key, bold=True)
                fg_lbl = THEME.ansi_fg("bright_foreground", bold=True)
                fg_key = THEME.ansi_fg("yellow", bold=True)
                fg_badge = THEME.ansi_fg(color_key, bold=False)
                # Avoid \033[0m inside the selected row to keep the background continuous
                left_part = f"{c_acc}┃ ❯{bg_sel} {fg_key}[{key_lbl}]{bg_sel} {fg_icon}{icon}  {fg_lbl}{label}"
                right_part = f"\033[22m{fg_badge}{badge} "
            else:
                fg_icon = THEME.ansi_fg(color_key, bold=False)
                fg_lbl = THEME.ansi_fg("foreground", bold=False)
                left_part = f"    {c_mut}[{key_lbl}]{rst} {fg_icon}{icon}{rst}  {fg_lbl}{label}{rst}"
                right_part = f"{c_dfg}{badge}{rst} "

            avail_gap = inner_w - visible_len(left_part) - visible_len(right_part)
            if avail_gap < 1:
                # Truncate the label if the terminal is narrow
                max_lbl = max(10, inner_w - visible_len(right_part) - 16)
                short_lbl = truncate_plain(label, max_lbl)
                if is_sel:
                    left_part = f"{c_acc}┃ ❯{bg_sel} {fg_key}[{key_lbl}]{bg_sel} {fg_icon}{icon}  {fg_lbl}{short_lbl}"
                else:
                    left_part = f"    {c_mut}[{key_lbl}]{rst} {fg_icon}{icon}{rst}  {fg_lbl}{short_lbl}{rst}"
                avail_gap = max(1, inner_w - visible_len(left_part) - visible_len(right_part))

            row_content = f"{left_part}{' ' * avail_gap}{right_part}"
            lines_buf.append(
                left_margin + self._box_line(row_content, inner_w, border_col, bg=(bg_sel if is_sel else ""))
            )

        # 4. Contextual footer inside the Card (or feedback Toast)
        lines_buf.append(left_margin + self._box_div(inner_w, dim_border))
        if self.status_toast and time.time() < self.status_toast_until:
            info_txt = truncate_plain(self.status_toast, inner_w - 5)
            info_row = f" {c_grn}✓{rst}  {c_fg}{info_txt}{rst}"
        else:
            info_txt = truncate_plain(selected_desc, inner_w - 5)
            info_row = f" {c_cyn}󰋼{rst}  {c_txt}{info_txt}{rst}"
        lines_buf.append(left_margin + self._box_line(info_row, inner_w, border_col))
        lines_buf.append(left_margin + self._box_bot(inner_w, border_col))

        # 5. Recent searches strip (when there is room)
        if show_recent_bar:
            recent_chunks: list[str] = []
            used_w = 14
            for q in search_hist[:4]:
                sq = truncate_plain(q, 18)
                piece = f"{c_txt}{sq}{rst}"
                if used_w + visible_len(piece) + 4 > card_total_w:
                    break
                recent_chunks.append(piece)
                used_w += visible_len(piece) + 4
            if recent_chunks:
                rec_line = f"{c_mut}󰋚 {tr('Recent:', 'Récents :', 'Recentes:')}{rst}  " + f"  {c_mut}•{rst}  ".join(recent_chunks)
                r_pad = " " * max(0, (cols - visible_len(rec_line)) // 2)
                lines_buf.append(f"{r_pad}{rec_line}")

        # 6. Shortcut legend
        leg_nav = tr("Navigate", "Naviguer", 'Navegar')
        leg_open = tr("Open", "Ouvrir", 'Abrir')
        leg_search = tr("Search", "Chercher", 'Buscar')
        leg_short = tr("Shortcut", "Raccourci", 'Atalho')
        leg_quit = tr("Quit", "Quitter", 'Sair')
        legend = (
            f"{c_yel}[↑/↓ j/k]{rst} {c_mut}{leg_nav}{rst}   "
            f"{c_yel}{tr('[Enter]', '[Entrée]', '[Enter]')}{rst} {c_mut}{leg_open}{rst}   "
            f"{c_yel}[/]{rst} {c_mut}{leg_search}{rst}   "
            f"{c_yel}[1-7]{rst} {c_mut}{leg_short}{rst}   "
            f"{c_red}{tr('[q/Esc]', '[q/Échap]', '[q/Esc]')}{rst} {c_mut}{leg_quit}{rst}"
        )
        if visible_len(legend) > cols - 2:
            legend = (
                f"{c_yel}[↑/↓]{rst} {leg_nav}  {c_yel}{tr('[Enter]', '[Entrée]', '[Enter]')}{rst} {leg_open}  "
                f"{c_yel}[/]{rst} {leg_search}  {c_red}[q]{rst} {leg_quit}"
            )
        leg_pad = " " * max(0, (cols - visible_len(legend)) // 2)
        lines_buf.append("")
        lines_buf.append(f"{leg_pad}{legend}")

        # Smooth vertical centering
        top_pad = max(0, (rows - len(lines_buf)) // 2)
        out: list[str] = ["\033[?2026h\033[H"]
        for _ in range(top_pad):
            out.append("\033[K")
        for ln in lines_buf:
            out.append(f"{ln}\033[K")
        out.append("\033[J\033[?2026l")

        sys.stdout.write("\n".join(out))
