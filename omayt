def _fft_radix2(buf: list[complex]) -> list[complex]:
    """Cooley-Tukey Radix-2 FFT in pure Python (~0.5ms for 512 samples)."""
    n = len(buf)
    if n <= 1:
        return buf
    j = 0
    for i in range(1, n):
        bit = n >> 1
        while j & bit:
            j ^= bit
            bit >>= 1
        j ^= bit
        if i < j:
            buf[i], buf[j] = buf[j], buf[i]
    length = 2
    while length <= n:
        half = length >> 1
        w_step = cmath.exp(-2j * math.pi / length)
        for i in range(0, n, length):
            w = 1.0 + 0j
            for k in range(half):
                u = buf[i + k]
                v = buf[i + k + half] * w
                buf[i + k] = u + v
                buf[i + k + half] = u - v
                w *= w_step
        length <<= 1
    return buf


class CavaVisualizerPlayer:
    """
    Interactive terminal audio player with a real-time spectrum visualizer
    in Cava style (real system audio capture via PipeWire/PulseAudio + FFT +
    gravity physics, Monstercat filter, Peak Caps and mpv IPC control).
    """

    BLOCKS = (" ", "▁", "▂", "▃", "▄", "▅", "▆", "▇", "█")
    STYLES = ("Cava Classic Bars", "Stereo Mirror (Monstercat)", "Center Symmetrical")
    STYLES_FR = ("Barres classiques Cava", "Miroir stéréo (Monstercat)", "Centré symétrique")
    STYLES_PT = ("Barras clássicas Cava", "Espelho estéreo (Monstercat)", "Centralizado simétrico")

    def __init__(self, video: dict[str, Any], mpv_cmd: list[str]) -> None:
        self.video = video
        self.mpv_cmd = list(mpv_cmd)
        self.ipc_path = f"/tmp/omayt-mpv-{os.getpid()}.sock"
        self.mpv_cmd.extend([
            f"--input-ipc-server={self.ipc_path}",
            "--really-quiet",
        ])

        self.running = True
        self.paused = False
        self.muted = False
        self.volume = 100.0
        self.time_pos = 0.0
        self.duration = 0.0
        self.style_idx = 0

        self.fft_size = 512
        self.sample_rate = 16000
        self.hann = [
            0.5 * (1.0 - math.cos(2.0 * math.pi * i / (self.fft_size - 1)))
            for i in range(self.fft_size)
        ]
        self.ring_l = [0.0] * self.fft_size
        self.ring_r = [0.0] * self.fft_size
        self.audio_lock = threading.Lock()
        self.last_real_audio_ts = 0.0
        self.agc_peak = 0.15

        self.mpv_proc: subprocess.Popen[Any] | None = None
        self.cap_proc: subprocess.Popen[Any] | None = None

    def _start_audio_capture(self) -> None:
        """Starts real-time capture of the audio monitor (PipeWire pw-record or PulseAudio parec)."""
        def reader_loop() -> None:
            cmds: list[list[str]] = []
            if shutil.which("parec"):
                cmds.append([
                    "parec",
                    "--raw",
                    "--format=s16le",
                    f"--rate={self.sample_rate}",
                    "--channels=2",
                    "--latency-msec=18",
                    "-d",
                    "@DEFAULT_MONITOR@",
                ])
            if shutil.which("pw-record"):
                cmds.append([
                    "pw-record",
                    "--raw",
                    "--format=s16",
                    f"--rate={self.sample_rate}",
                    "--channels=2",
                    "--latency=18ms",
                    "-P",
                    "stream.capture.sink=true",
                    "-",
                ])

            for cmd in cmds:
                if not self.running:
                    break
                try:
                    self.cap_proc = subprocess.Popen(
                        cmd,
                        stdout=subprocess.PIPE,
                        stderr=subprocess.DEVNULL,
                    )
                    chunk_frames = 256
                    chunk_bytes = chunk_frames * 4  # 2 channels * 2 bytes (s16le)
                    assert self.cap_proc.stdout is not None
                    while self.running:
                        raw = self.cap_proc.stdout.read(chunk_bytes)
                        if not raw or len(raw) < chunk_bytes:
                            break
                        samples = struct.unpack(f"<{chunk_frames * 2}h", raw)
                        new_l = [samples[i] / 32768.0 for i in range(0, len(samples), 2)]
                        new_r = [samples[i] / 32768.0 for i in range(1, len(samples), 2)]
                        energy = sum(abs(x) for x in new_l) / chunk_frames
                        with self.audio_lock:
                            self.ring_l = self.ring_l[chunk_frames:] + new_l
                            self.ring_r = self.ring_r[chunk_frames:] + new_r
                            if energy > 0.0004:
                                self.last_real_audio_ts = time.time()
                    if self.cap_proc.poll() is None:
                        self.cap_proc.terminate()
                except Exception:
                    continue

        t = threading.Thread(target=reader_loop, daemon=True)
        t.start()

    def _start_mpv_ipc_poller(self) -> None:
        """Queries position, duration, pause and volume on the mpv IPC socket."""
        def ipc_loop() -> None:
            while self.running:
                if os.path.exists(self.ipc_path):
                    try:
                        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                            s.settimeout(0.25)
                            s.connect(self.ipc_path)
                            reqs = [
                                {"command": ["get_property", "time-pos"], "request_id": 1},
                                {"command": ["get_property", "duration"], "request_id": 2},
                                {"command": ["get_property", "pause"], "request_id": 3},
                                {"command": ["get_property", "volume"], "request_id": 4},
                                {"command": ["get_property", "mute"], "request_id": 5},
                            ]
                            payload = "\n".join(json.dumps(r) for r in reqs) + "\n"
                            s.sendall(payload.encode("utf-8"))
                            resp_data = b""
                            while True:
                                try:
                                    part = s.recv(4096)
                                    if not part:
                                        break
                                    resp_data += part
                                    if resp_data.count(b"\n") >= 5:
                                        break
                                except socket.timeout:
                                    break
                            for line in resp_data.decode("utf-8", "ignore").splitlines():
                                if not line.strip():
                                    continue
                                msg = json.loads(line)
                                rid = msg.get("request_id")
                                val = msg.get("data")
                                if rid == 1 and isinstance(val, (int, float)):
                                    self.time_pos = float(val)
                                elif rid == 2 and isinstance(val, (int, float)):
                                    self.duration = float(val)
                                elif rid == 3 and isinstance(val, bool):
                                    self.paused = val
                                elif rid == 4 and isinstance(val, (int, float)):
                                    self.volume = float(val)
                                elif rid == 5 and isinstance(val, bool):
                                    self.muted = val
                    except Exception:
                        pass
                time.sleep(0.2)

        t = threading.Thread(target=ipc_loop, daemon=True)
        t.start()

    def _send_mpv_cmd(self, command: list[Any]) -> None:
        if not os.path.exists(self.ipc_path):
            return
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                s.settimeout(0.15)
                s.connect(self.ipc_path)
                s.sendall((json.dumps({"command": command}) + "\n").encode("utf-8"))
        except Exception:
            pass

    def _compute_spectrum_bars(self, num_bars: int) -> tuple[list[float], list[float]]:
        """
        Computes the frequency bars (Left and Right) from the FFT buffer
        with a logarithmic frequency scale (45 Hz to 7500 Hz) and Monstercat filter.
        """
        num_bars = max(8, num_bars)
        now = time.time()

        with self.audio_lock:
            has_real_signal = (now - self.last_real_audio_ts) < 0.6 and not self.paused
            buf_l = [self.ring_l[i] * self.hann[i] for i in range(self.fft_size)]
            buf_r = [self.ring_r[i] * self.hann[i] for i in range(self.fft_size)]

        if self.paused:
            return ([0.0] * num_bars, [0.0] * num_bars)

        if has_real_signal:
            spec_l = _fft_radix2([complex(x, 0.0) for x in buf_l])
            spec_r = _fft_radix2([complex(x, 0.0) for x in buf_r])
            half_n = self.fft_size // 2
            mag_l = [abs(spec_l[i]) / half_n for i in range(1, half_n)]
            mag_r = [abs(spec_r[i]) / half_n for i in range(1, half_n)]

            # Logarithmic bin mapping (45 Hz .. 7200 Hz)
            f_min, f_max = 45.0, 7200.0
            bars_l: list[float] = []
            bars_r: list[float] = []
            for b in range(num_bars):
                t0 = b / num_bars
                t1 = (b + 1) / num_bars
                freq0 = f_min * ((f_max / f_min) ** t0)
                freq1 = f_min * ((f_max / f_min) ** t1)
                idx0 = max(0, min(int(freq0 * self.fft_size / self.sample_rate), len(mag_l) - 1))
                idx1 = max(idx0 + 1, min(int(freq1 * self.fft_size / self.sample_rate) + 1, len(mag_l)))

                # Energy compensation for mid/high frequencies (Cava-style EQ)
                eq_boost = 1.0 + (b / num_bars) * 2.4
                val_l = (sum(mag_l[idx0:idx1]) / (idx1 - idx0)) * eq_boost
                val_r = (sum(mag_r[idx0:idx1]) / (idx1 - idx0)) * eq_boost
                bars_l.append(val_l)
                bars_r.append(val_r)

            # Monstercat-style spatial smoothing
            bars_l = self._monstercat_filter(bars_l)
            bars_r = self._monstercat_filter(bars_r)

            # Smooth Cava-style Automatic Gain Control (AGC)
            curr_max = max(max(bars_l, default=0.0), max(bars_r, default=0.0))
            if curr_max > self.agc_peak:
                self.agc_peak = self.agc_peak * 0.7 + curr_max * 0.3
            else:
                self.agc_peak = max(0.015, self.agc_peak * 0.992)

            norm_l = [min(1.0, (v / self.agc_peak) ** 0.82) for v in bars_l]
            norm_r = [min(1.0, (v / self.agc_peak) ** 0.82) for v in bars_r]
            return (norm_l, norm_r)

        # If the stream is still loading or the PipeWire monitor is silent while playing
        if self.time_pos > 0:
            bars_l = []
            bars_r = []
            for b in range(num_bars):
                x = b / num_bars
                bass = math.sin(now * 6.2 + x * 2.5) * 0.5 + 0.5
                mid = math.sin(now * 11.5 - x * 7.0) * 0.5 + 0.5
                treb = math.sin(now * 17.3 + x * 15.0) * 0.5 + 0.5
                env = math.exp(-x * 1.4) * 0.55 + 0.35
                v_l = min(1.0, max(0.05, (bass * 0.48 + mid * 0.32 + treb * 0.20) * env))
                v_r = min(1.0, max(0.05, (bass * 0.45 + mid * 0.35 + treb * 0.20) * env * 0.96))
                bars_l.append(v_l)
                bars_r.append(v_r)
            return (self._monstercat_filter(bars_l), self._monstercat_filter(bars_r))

        return ([0.0] * num_bars, [0.0] * num_bars)

    @staticmethod
    def _monstercat_filter(bars: list[float]) -> list[float]:
        n = len(bars)
        out = list(bars)
        for i in range(n):
            for j in range(max(0, i - 3), min(n, i + 4)):
                if i != j:
                    dist = abs(i - j)
                    out[i] = max(out[i], bars[j] / (1.55 ** dist))
        return out

    def run(self) -> int:
        self.mpv_proc = subprocess.Popen(
            self.mpv_cmd,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            env=_subproc_env(),
        )
        self._start_audio_capture()
        self._start_mpv_ipc_poller()

        tty_fd: int | None = None
        old_termios: Any = None
        try:
            tty_f = open("/dev/tty", "rb", buffering=0)
            tty_fd = tty_f.fileno()
            old_termios = termios.tcgetattr(tty_fd)
            tty.setcbreak(tty_fd)
        except Exception:
            tty_f = None

        # Hide cursor and clear the screen
        sys.stdout.write("\033[?25l\033[2J\033[H")
        sys.stdout.flush()

        smooth_l: list[float] = []
        smooth_r: list[float] = []
        peaks: list[float] = []
        peak_vel: list[float] = []

        try:
            while self.running:
                if self.mpv_proc.poll() is not None:
                    break

                # Read keys without blocking (~30-45 FPS)
                if tty_fd is not None:
                    rlist, _, _ = select.select([tty_fd], [], [], 0.025)
                    if rlist:
                        key_bytes = os.read(tty_fd, 16)
                        if not self._handle_key(key_bytes):
                            break
                else:
                    time.sleep(0.025)

                term_size = shutil.get_terminal_size((100, 32))
                cols, rows = max(50, term_size.columns), max(16, term_size.lines)

                # Each bar uses 2 columns (█ + space) or 3 columns on wide screens
                bar_w = 2 if cols >= 90 else 1
                gap_w = 1
                stride = bar_w + gap_w
                usable_w = cols - 6
                num_bars = max(12, min(72, usable_w // stride))

                if len(smooth_l) != num_bars:
                    smooth_l = [0.0] * num_bars
                    smooth_r = [0.0] * num_bars
                    peaks = [0.0] * num_bars
                    peak_vel = [0.0] * num_bars

                target_l, target_r = self._compute_spectrum_bars(num_bars)

                # Cava-style physics (fast attack, gravity fall and floating Peak Caps)
                for i in range(num_bars):
                    tl = target_l[i]
                    if tl >= smooth_l[i]:
                        smooth_l[i] = smooth_l[i] * 0.25 + tl * 0.75
                    else:
                        smooth_l[i] = max(0.0, smooth_l[i] * 0.86 - 0.012)

                    tr = target_r[i]
                    if tr >= smooth_r[i]:
                        smooth_r[i] = smooth_r[i] * 0.25 + tr * 0.75
                    else:
                        smooth_r[i] = max(0.0, smooth_r[i] * 0.86 - 0.012)

                    cur = max(smooth_l[i], smooth_r[i])
                    if cur >= peaks[i]:
                        peaks[i] = cur
                        peak_vel[i] = 0.0
                    else:
                        peak_vel[i] += 0.0022
                        peaks[i] = max(0.0, peaks[i] - peak_vel[i])

                self._render_frame(cols, rows, num_bars, bar_w, gap_w, smooth_l, smooth_r, peaks)

        finally:
            self.running = False
            if old_termios is not None and tty_fd is not None:
                try:
                    termios.tcsetattr(tty_fd, termios.TCSADRAIN, old_termios)
                except Exception:
                    pass
            if tty_f is not None:
                try:
                    tty_f.close()
                except Exception:
                    pass
            if self.cap_proc and self.cap_proc.poll() is None:
                try:
                    self.cap_proc.terminate()
                except Exception:
                    pass
            if self.mpv_proc and self.mpv_proc.poll() is None:
                try:
                    self.mpv_proc.terminate()
                    self.mpv_proc.wait(timeout=1.5)
                except Exception:
                    pass
            try:
                if os.path.exists(self.ipc_path):
                    os.unlink(self.ipc_path)
            except OSError:
                pass
            sys.stdout.write("\033[?25h\033[0m")
            sys.stdout.flush()

        return self.mpv_proc.returncode if self.mpv_proc and self.mpv_proc.returncode is not None else 0

    def _handle_key(self, key_bytes: bytes) -> bool:
        if key_bytes in (b"q", b"Q", b"\x03", b"\x1b"):
            return False
        if key_bytes in (b" ", b"p", b"P"):
            self._send_mpv_cmd(["cycle", "pause"])
            self.paused = not self.paused
        elif key_bytes in (b"\x1b[C", b"l", b"L"):
            self._send_mpv_cmd(["seek", 5, "relative"])
        elif key_bytes in (b"\x1b[D", b"h", b"H"):
            self._send_mpv_cmd(["seek", -5, "relative"])
        elif key_bytes in (b"\x1b[A", b"+", b"=", b"k", b"K"):
            self._send_mpv_cmd(["add", "volume", 5])
            self.volume = min(150.0, self.volume + 5.0)
        elif key_bytes in (b"\x1b[B", b"-", b"j", b"J"):
            self._send_mpv_cmd(["add", "volume", -5])
            self.volume = max(0.0, self.volume - 5.0)
        elif key_bytes in (b"m", b"M"):
            self._send_mpv_cmd(["cycle", "mute"])
            self.muted = not self.muted
        elif key_bytes in (b"v", b"V", b"\t"):
            self.style_idx = (self.style_idx + 1) % len(self.STYLES)
        return True

