def parse_channel_query(raw_query: str) -> tuple[str, str] | None:
    """
    Parses `<channel>/` or `<channel>/<term>` channel-scoped queries.
    Returns `(channel_spec, sub_query)` or `None` for normal searches and URLs.
    """
    q = (raw_query or "").strip()
    if not q or "/" not in q:
        return None
    q_low = q.lower()
    if "://" in q_low or q_low.startswith(
        (
            "http://",
            "https://",
            "www.",
            "youtube.com/",
            "m.youtube.com/",
            "music.youtube.com/",
            "youtu.be/",
        )
    ):
        return None
    channel_spec, sub_query = q.split("/", 1)
    channel_spec = channel_spec.strip()
    sub_query = sub_query.strip()
    if not channel_spec:
        return None
    return (channel_spec, sub_query)


def _duration_to_seconds(value: Any) -> int | None:
    if value is None or value == "":
        return None
    if isinstance(value, (int, float)):
        sec = int(value)
        return sec if sec >= 0 else None
    if isinstance(value, str):
        txt = value.strip()
        if not txt or txt.upper() in ("LIVE", "DIRECT", "AO VIVO"):
            return None
        parts = txt.split(":")
        if all(p.isdigit() for p in parts) and 2 <= len(parts) <= 3:
            total = 0
            for p in parts:
                total = total * 60 + int(p)
            return total
    return None


def _ytdlp_extract_flat(target: str, playlist_end: int | None = None) -> dict[str, Any]:
    """Extracts flat playlist/search info via yt_dlp module with CLI subprocess fallback."""
    try:
        import yt_dlp  # type: ignore

        ydl_opts: dict[str, Any] = {
            "extract_flat": "in_playlist",
            "skip_download": True,
            "quiet": True,
            "no_warnings": True,
            "extractor_args": EXTRACTOR_ARGS_DICT,
        }
        if playlist_end is not None and playlist_end > 0:
            ydl_opts["playlistend"] = int(playlist_end)
        with yt_dlp.YoutubeDL(ydl_opts) as ydl:
            info = ydl.extract_info(target, download=False)
            if isinstance(info, dict):
                return info
    except Exception:
        cmd = [
            YTDLP_BIN,
            "--extractor-args",
            EXTRACTOR_ARGS_CLI,
            "--flat-playlist",
            "-J",
            "--no-warnings",
        ]
        if playlist_end is not None and playlist_end > 0:
            cmd.extend(["--playlist-end", str(int(playlist_end))])
        cmd.append(target)
        proc = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
        if proc.returncode == 0 and proc.stdout:
            try:
                info = json.loads(proc.stdout)
                if isinstance(info, dict):
                    return info
            except Exception:
                pass
    return {}


def _norm_channel_token(text: str) -> str:
    return re.sub(r"[^a-z0-9]+", "", (text or "").strip().lower().lstrip("@"))


def resolve_youtube_channel(channel_spec: str) -> dict[str, str] | None:
    """
    Resolves a channel name, @handle or UC... channel ID into
    `{"id": "UC...", "url": "https://www.youtube.com/channel/UC...", "title": "...", "handle": "@..."}`.
    Uses in-memory + disk cache so pagination and repeated queries are instant.
    """
    spec = (channel_spec or "").strip()
    if not spec:
        return None
    cache_key = spec.lower()

    if cache_key in _CHANNEL_MEM_CACHE:
        return dict(_CHANNEL_MEM_CACHE[cache_key])

    disk_cache = load_json_file(CHANNEL_CACHE_FILE, {})
    if isinstance(disk_cache, dict) and isinstance(disk_cache.get(cache_key), dict):
        cached = disk_cache[cache_key]
        if cached.get("url"):
            _CHANNEL_MEM_CACHE[cache_key] = dict(cached)
            return dict(cached)

    def _store(entry: dict[str, str]) -> dict[str, str]:
        _CHANNEL_MEM_CACHE[cache_key] = dict(entry)
        try:
            cache_obj = load_json_file(CHANNEL_CACHE_FILE, {})
            if not isinstance(cache_obj, dict):
                cache_obj = {}
            cache_obj[cache_key] = dict(entry)
            if len(cache_obj) > 100:
                for old_k in list(cache_obj.keys())[:-100]:
                    cache_obj.pop(old_k, None)
            save_json_file(CHANNEL_CACHE_FILE, cache_obj)
        except Exception:
            pass
        return dict(entry)

    # 1. Direct UC... channel ID
    if re.fullmatch(r"UC[a-zA-Z0-9_-]{22}", spec):
        return _store(
            {
                "id": spec,
                "url": f"https://www.youtube.com/channel/{spec}",
                "title": spec,
                "handle": "",
            }
        )

    # 2. Explicit @handle: try direct URL first, fall back to YouTube channel search on 404/empty
    if spec.startswith("@"):
        handle_url = f"https://www.youtube.com/{urllib.parse.quote(spec, safe='@._-')}/videos"
        info = _ytdlp_extract_flat(handle_url, playlist_end=1)
        cid = str(info.get("channel_id") or "")
        entries = info.get("entries") or []
        if cid.startswith("UC") or entries:
            base_url = (
                f"https://www.youtube.com/channel/{cid}"
                if cid.startswith("UC")
                else f"https://www.youtube.com/{urllib.parse.quote(spec, safe='@._-')}"
            )
            return _store(
                {
                    "id": cid,
                    "url": base_url,
                    "title": str(info.get("channel") or info.get("uploader") or spec),
                    "handle": str(info.get("uploader_id") or spec),
                }
            )

    # 3. YouTube Channels search (sp=EgIQAg%3D%3D)
    search_term = spec.lstrip("@").strip()
    if not search_term:
        return None
    search_url = (
        f"https://www.youtube.com/results?search_query="
        f"{urllib.parse.quote_plus(search_term)}&sp=EgIQAg%3D%3D"
    )
    info = _ytdlp_extract_flat(search_url, playlist_end=8)
    raw_entries = info.get("entries") or []

    candidates: list[dict[str, str]] = []
    for item in raw_entries:
        if not isinstance(item, dict):
            continue
        cid = str(item.get("channel_id") or item.get("id") or "")
        if not cid.startswith("UC"):
            continue
        title = str(item.get("channel") or item.get("title") or item.get("uploader") or search_term).strip()
        handle = str(item.get("uploader_id") or "").strip()
        candidates.append(
            {
                "id": cid,
                "url": f"https://www.youtube.com/channel/{cid}",
                "title": title,
                "handle": handle,
            }
        )

    if not candidates:
        return None

    target_low = search_term.lower()
    target_norm = _norm_channel_token(search_term)
    chosen = None
    # Tier 1: exact match on handle or channel title
    for cand in candidates:
        h_low = cand["handle"].lstrip("@").lower()
        t_low = cand["title"].lower()
        if h_low == target_low or t_low == target_low:
            chosen = cand
            break
    # Tier 2: exact normalized token match
    if chosen is None and target_norm:
        for cand in candidates:
            if (
                (cand["handle"] and _norm_channel_token(cand["handle"]) == target_norm)
                or _norm_channel_token(cand["title"]) == target_norm
            ):
                chosen = cand
                break
    # Tier 3: title or handle starts with the searched term (preserving YouTube relevance order)
    if chosen is None and target_norm:
        for cand in candidates:
            h_low = cand["handle"].lstrip("@").lower()
            t_low = cand["title"].lower()
            if (
                t_low.startswith(target_low)
                or h_low.startswith(target_low)
                or _norm_channel_token(cand["title"]).startswith(target_norm)
            ):
                chosen = cand
                break
    if chosen is None:
        chosen = candidates[0]

    return _store(chosen)


def format_duration(seconds: Any) -> str:
    if not seconds:
        return tr("LIVE", "DIRECT", "AO VIVO")
    if isinstance(seconds, str):
        if seconds.strip().upper() in ("LIVE", "DIRECT", "EN DIRECT", "AO VIVO"):
            return tr("LIVE", "DIRECT", "AO VIVO")
        return seconds
    try:
        sec = int(float(seconds))
    except (ValueError, TypeError):
        return "??:??"
    h, rem = divmod(sec, 3600)
    m, s = divmod(rem, 60)
    if h > 0:
        return f"{h}:{m:02d}:{s:02d}"
    return f"{m:02d}:{s:02d}"


def format_views(count: Any) -> str:
    if count is None or count == "":
        return "—"
    try:
        n = int(count)
    except (ValueError, TypeError):
        return str(count)
    if n >= 1_000_000_000:
        return f"{n / 1_000_000_000:.1f}B"
    if n >= 1_000_000:
        return f"{n / 1_000_000:.1f}M"
    if n >= 1_000:
        return f"{n / 1_000:.1f}K"
    sep = tr(",", "\u202f", ".")
    return f"{n:,}".replace(",", sep)


def localize_duration(raw_duration: Any, duration_raw: Any = None) -> str:
    """Normalizes cached duration strings (e.g. 'AO VIVO' / 'DIRECT') to the active UI language."""
    if isinstance(duration_raw, (int, float)) and duration_raw > 0:
        return format_duration(duration_raw)
    if raw_duration is None or raw_duration == "":
        return tr("LIVE", "DIRECT", "AO VIVO") if duration_raw is None else "—"
    txt = str(raw_duration).strip()
    if txt.upper() in ("LIVE", "DIRECT", "EN DIRECT", "AO VIVO"):
        return tr("LIVE", "DIRECT", "AO VIVO")
    return txt


def localize_video_title(raw_title: Any, video_id: str = "") -> str:
    """Normalizes fallback video titles ('Sem título', 'Vídeo <id>', etc.) to the active UI language."""
    txt = str(raw_title or "").strip()
    if not txt or txt in ("Untitled", "Sans titre", "Sem título"):
        return tr("Untitled", "Sans titre", "Sem título")
    m = re.fullmatch(r"(?:Video|Vidéo|Vídeo)\s+([a-zA-Z0-9_-]{11})", txt)
    if m:
        vid = m.group(1)
        return tr(f"Video {vid}", f"Vidéo {vid}", f"Vídeo {vid}")
    return txt


def localize_views(raw_views: Any, views_raw: Any = None) -> str:
    """Normalizes cached view counts to the active UI language."""
    if isinstance(views_raw, (int, float)):
        return format_views(views_raw)
    if raw_views is None or raw_views == "":
        return "—"
    txt = str(raw_views).strip()
    low = txt.lower()
    if low in ("no views", "aucune vue", "sem visualizações", "0 views", "0 vues", "0 visualizações"):
        return "0"
    for suffix in (" visualizações", " visualização", " vues", " vue", " views", " view"):
        if low.endswith(suffix):
            num_part = txt[: -len(suffix)].strip()
            digits = re.sub(r"[.,\s\u202f]", "", num_part)
            if digits.isdigit():
                return format_views(int(digits))
            return num_part or "—"
    return txt


def _apply_channel_local_filter(
    videos: list[dict[str, Any]],
    search_filter: str,
) -> list[dict[str, Any]]:
    flt = normalize_search_filter(search_filter)
    if flt == "views":
        return sorted(
            videos,
            key=lambda v: (
                int(v["views_raw"])
                if isinstance(v.get("views_raw"), (int, float))
                else -1
            ),
            reverse=True,
        )
    if flt == "short":
        return [
            v
            for v in videos
            if isinstance(v.get("duration_raw"), int) and 0 < v["duration_raw"] < 180
        ]
    if flt == "medium":
        return [
            v
            for v in videos
            if isinstance(v.get("duration_raw"), int) and 180 <= v["duration_raw"] <= 1200
        ]
    if flt == "long":
        return [
            v
            for v in videos
            if isinstance(v.get("duration_raw"), int) and v["duration_raw"] > 1200
        ]
    if flt == "live":
        return [
            v
            for v in videos
            if v.get("duration_raw") is None
            or str(v.get("duration") or "").upper() in ("LIVE", "DIRECT", "AO VIVO")
        ]
    return videos


def format_search_header_note(
    query: str,
    count: int,
    search_filter: str = "all",
    channel_title: str = "",
    channel_subquery: str = "",
    is_last: bool = False,
    reached_end: bool = False,
) -> str:
    vid_word = tr("video", "vidéo", "vídeo")
    vid_cnt = f"{count} {vid_word}{'s' if count != 1 else ''}"
    flt = normalize_search_filter(search_filter)
    flt_tag = (
        f" • [{tr('Filter:', 'Filtre :', 'Filtro:')} {get_search_filter_label(flt, short=True)}]"
        if flt != "all"
        else ""
    )
    end_tag = f" ({tr('end', 'fin', 'fim')})" if reached_end else ""
    if channel_title:
        ch_lbl = tr("Channel:", "Chaîne :", "Canal:")
        sub_part = f" / {channel_subquery}" if channel_subquery else ""
        return f"{ch_lbl} {channel_title}{sub_part} ({query}) • {vid_cnt}{flt_tag}{end_tag}"
    prefix = (
        tr("Last search:", "Dernière recherche :", "Última busca:")
        if is_last
        else tr("Search:", "Recherche :", "Busca:")
    )
    return f"{prefix} {query} • {vid_cnt}{flt_tag}{end_tag}"


def search_youtube(
    query: str,
    max_results: int = SEARCH_PAGE_SIZE,
    record_history: bool = True,
    prefetch: bool = True,
    search_filter: str = "all",
) -> list[dict[str, Any]]:
    ensure_dirs()
    query = query.strip()
    if not query:
        return []

    flt = normalize_search_filter(search_filter)
    if record_history:
        record_search_history(query)

    entries_raw: list[dict[str, Any]] = []
    channel_parsed = parse_channel_query(query)
    resolved_channel_id = ""
    resolved_channel_title = ""
    channel_spec = ""
    channel_subquery = ""
    root_info: dict[str, Any] = {}

    if channel_parsed is not None:
        channel_spec, channel_subquery = channel_parsed
        ch_info = resolve_youtube_channel(channel_spec)
        if ch_info is not None:
            resolved_channel_id = ch_info.get("id") or ""
            resolved_channel_title = ch_info.get("title") or channel_spec
            base_url = ch_info["url"].rstrip("/")
            if channel_subquery:
                target_url = f"{base_url}/search?query={urllib.parse.quote_plus(channel_subquery)}"
            else:
                target_url = f"{base_url}/videos"
            # Over-fetch when filtering locally by duration/live or channel sub-search (playlists skipped)
            fetch_limit = max_results
            if flt in ("short", "medium", "long", "live"):
                fetch_limit = max(max_results * 3, 90)
            elif channel_subquery or flt == "views":
                fetch_limit = max(max_results + 20, max_results)
            root_info = _ytdlp_extract_flat(target_url, playlist_end=fetch_limit)
            entries_raw = root_info.get("entries") or []
            if root_info.get("channel") or root_info.get("uploader"):
                resolved_channel_title = str(
                    root_info.get("channel") or root_info.get("uploader") or resolved_channel_title
                ).strip()
            if not resolved_channel_id and root_info.get("channel_id"):
                resolved_channel_id = str(root_info.get("channel_id"))
    else:
        flt_meta = get_search_filter_meta(flt)
        sp = flt_meta["sp"]
        if sp:
            search_url = (
                f"https://www.youtube.com/results?search_query="
                f"{urllib.parse.quote_plus(query)}&sp={sp}"
            )
            root_info = _ytdlp_extract_flat(search_url, playlist_end=max_results + 12)
            entries_raw = root_info.get("entries") or []
        else:
            root_info = _ytdlp_extract_flat(f"ytsearch{max_results}:{query}")
            entries_raw = root_info.get("entries") or []

    results: list[dict[str, Any]] = []
    seen_ids: set[str] = set()
    db = load_json_file(VIDEOS_DB_FILE, {})
    untitled = tr("Untitled", "Sans titre", "Sem título")

    for item in entries_raw:
        if not isinstance(item, dict):
            continue
        vid = item.get("id") or ""
        if not vid or len(vid) != 11 or vid in seen_ids:
            continue
        # Enforce strict channel exclusivity when in channel/ mode
        if channel_parsed is not None and resolved_channel_id:
            item_cid = str(item.get("channel_id") or "")
            if item_cid and item_cid != resolved_channel_id:
                continue
        seen_ids.add(vid)

        title = (item.get("title") or untitled).replace("\t", " ").replace("\n", " ").strip()
        channel = (
            item.get("channel")
            or item.get("uploader")
            or resolved_channel_title
            or item.get("channel_id")
            or "YouTube"
        ).replace("\t", " ").strip()
        dur_raw = _duration_to_seconds(item.get("duration") or item.get("duration_string"))
        duration = format_duration(item.get("duration") or item.get("duration_string"))
        views_raw = item.get("view_count")
        views_fmt = format_views(views_raw)
        url = item.get("url") or f"https://www.youtube.com/watch?v={vid}"
        if not url.startswith("http"):
            url = f"https://www.youtube.com/watch?v={vid}"

        thumbs = item.get("thumbnails") or []
        thumb_url = f"https://i.ytimg.com/vi/{vid}/maxresdefault.jpg"
        if isinstance(thumbs, list) and thumbs:
            last_t = thumbs[-1]
            if isinstance(last_t, dict) and last_t.get("url"):
                thumb_url = last_t["url"]

        desc = item.get("description") or ""
        video_obj = {
            "id": vid,
            "title": title,
            "channel": channel,
            "channel_id": str(item.get("channel_id") or resolved_channel_id or ""),
            "duration": duration,
            "duration_raw": dur_raw,
            "views": views_fmt,
            "views_raw": views_raw,
            "url": url,
            "thumb_url": thumb_url,
            "description": desc,
            "query": query,
            "filter": flt,
            "timestamp": time.strftime("%d/%m/%Y %H:%M"),
        }
        results.append(video_obj)
        db[vid] = video_obj

    if channel_parsed is not None and flt != "all":
        results = _apply_channel_local_filter(results, flt)

    if len(results) > max_results:
        results = results[:max_results]

    save_json_file(VIDEOS_DB_FILE, db)
    save_json_file(LAST_LIST_FILE, results)
    save_json_file(
        STATE_FILE,
        {
            "mode": "channel" if channel_parsed is not None else "search",
            "query": query,
            "filter": flt,
            "channel_spec": channel_spec,
            "channel_title": resolved_channel_title,
            "channel_id": resolved_channel_id,
            "channel_subquery": channel_subquery,
            "count": len(results),
            "limit": max_results,
            "has_more": bool(results),
        },
    )

    if prefetch and results:
        first_ids = [r["id"] for r in results[:2]]
        with concurrent.futures.ThreadPoolExecutor(max_workers=2) as pool:
            pool.map(download_single_thumb, first_ids)
        prefetch_thumbnails_async([r["id"] for r in results[2:]])

    return results


def load_more_youtube_results(
    query: str,
    existing_videos: list[dict[str, Any]],
    current_limit: int,
    page_size: int = SEARCH_PAGE_SIZE,
    search_filter: str = "all",
) -> tuple[list[dict[str, Any]], int, int]:
    """Loads `page_size` more results for the current search, keeping the displayed order."""
    query = query.strip()
    if not query:
        return (list(existing_videos), current_limit, 0)

    flt = normalize_search_filter(search_filter)
    new_limit = max(current_limit, len(existing_videos)) + page_size
    fetched = search_youtube(
        query,
        max_results=new_limit,
        record_history=False,
        prefetch=False,
        search_filter=flt,
    )
    latest_state = load_json_file(STATE_FILE, {})

    seen_ids = {v.get("id") for v in existing_videos if v.get("id")}
    merged = list(existing_videos)
    new_items: list[dict[str, Any]] = []
    for item in fetched:
        vid = item.get("id")
        if vid and vid not in seen_ids:
            seen_ids.add(vid)
            merged.append(item)
            new_items.append(item)

    added = len(new_items)
    save_json_file(LAST_LIST_FILE, merged)
    save_json_file(
        STATE_FILE,
        {
            "mode": latest_state.get("mode", "search"),
            "query": query,
            "filter": flt,
            "channel_spec": latest_state.get("channel_spec", ""),
            "channel_title": latest_state.get("channel_title", ""),
            "channel_id": latest_state.get("channel_id", ""),
            "channel_subquery": latest_state.get("channel_subquery", ""),
            "count": len(merged),
            "limit": new_limit,
            "has_more": added > 0,
        },
    )

    if new_items:
        first_new = [r["id"] for r in new_items[:2]]
        with concurrent.futures.ThreadPoolExecutor(max_workers=2) as pool:
            pool.map(download_single_thumb, first_new)
        prefetch_thumbnails_async([r["id"] for r in new_items[2:]])

    return (merged, new_limit, added)


