def record_watch_history(video: dict[str, Any]) -> None:
    hist: list[dict[str, Any]] = load_json_file(HISTORY_FILE, [])
    vid = video.get("id")
    hist = [v for v in hist if v.get("id") != vid]
    entry = dict(video)
    entry["watched_at"] = time.strftime("%d/%m/%Y %H:%M:%S")
    hist.insert(0, entry)
    save_json_file(HISTORY_FILE, hist[:100])


def record_search_history(query: str) -> None:
    hist: list[str] = load_json_file(SEARCH_HIST_FILE, [])
    hist = [q for q in hist if q.lower() != query.lower()]
    hist.insert(0, query)
    save_json_file(SEARCH_HIST_FILE, hist[:50])


