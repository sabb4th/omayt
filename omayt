def _lang_code(raw: str) -> str | None:
    """Extracts a supported language code from a locale-ish string ("pt-BR" / "fr_FR.UTF-8" -> "pt" / "fr")."""
    code = raw.strip().lower().replace("_", "-").split(".")[0].split("@")[0].split("-")[0]
    return code if code in UI_LANGS else None


def _env_ui_lang() -> str | None:
    return _lang_code(os.environ.get("OMAYT_LANG") or "")


def _read_settings() -> dict[str, Any]:
    try:
        data = json.loads(SETTINGS_FILE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def _saved_ui_lang() -> str | None:
    lang = _read_settings().get("lang")
    return lang if lang in UI_LANGS else None


def _omarchy_ui_lang() -> str | None:
    """Reads Omarchy's configured UI language (~/.config/omarchy/language or uwsm env)."""
    cfg_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    env_file = os.environ.get("OMARCHY_LANGUAGE_FILE")
    lang_file = Path(env_file) if env_file else (cfg_home / "omarchy" / "language")
    try:
        raw = lang_file.read_text(encoding="utf-8").splitlines()[0].strip()
    except (OSError, IndexError):
        raw = ""
    if raw:
        return _lang_code(raw) or "en"

    uwsm_lang_file = cfg_home / "uwsm" / "env.d" / "50-omarchy-language"
    try:
        for line in uwsm_lang_file.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if line.startswith("export LANG="):
                val = line.split("=", 1)[1].strip().strip('"').strip("'")
                if val:
                    return _lang_code(val) or "en"
    except OSError:
        pass
    return None


def _locale_ui_lang() -> str | None:
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        code = _lang_code(os.environ.get(var) or "")
        if code:
            return code
    return None


def _resolve_ui_lang() -> tuple[str, str]:
    """Returns (language, source) with source in {"env", "settings", "omarchy", "locale", "default"}."""
    env = _env_ui_lang()
    if env:
        return env, "env"
    saved = _saved_ui_lang()
    if saved:
        return saved, "settings"
    omarchy_lang = _omarchy_ui_lang()
    if omarchy_lang:
        return omarchy_lang, "omarchy"
    locale_lang = _locale_ui_lang()
    if locale_lang:
        return locale_lang, "locale"
    return "en", "default"


APP_LANG, APP_LANG_SOURCE = _resolve_ui_lang()


def tr(en: str, fr: str, pt: str) -> str:
    """Returns the string for the active UI language (English is the reference)."""
    if APP_LANG == "fr":
        return fr
    if APP_LANG == "pt":
        return pt
    return en


def ui_lang_name(code: str) -> str:
    """Returns the localized display name for a language code in the active UI language."""
    en_lbl, fr_lbl, pt_lbl = LANG_LABELS.get(code, LANG_LABELS["en"])
    return tr(en_lbl, fr_lbl, pt_lbl)


def set_runtime_ui_lang(code: str, source: str = "cli") -> bool:
    """Sets the active UI language for the current process without writing settings.json."""
    global APP_LANG, APP_LANG_SOURCE
    norm = _lang_code(code)
    if not norm:
        return False
    APP_LANG, APP_LANG_SOURCE = norm, source
    return True


def _subproc_env() -> dict[str, str]:
    """Builds a subprocess environment propagating the active UI language and locale."""
    env = dict(os.environ)
    env["OMAYT_LANG"] = APP_LANG
    if APP_LANG == "en":
        ctype = env.get("LC_ALL") or env.get("LC_CTYPE") or env.get("LANG") or "C.UTF-8"
        if "utf" not in ctype.lower():
            ctype = "C.UTF-8"
        env.pop("LC_ALL", None)
        env["LC_CTYPE"] = ctype
        env["LC_MESSAGES"] = "C"
        env["LANGUAGE"] = "en"
    return env


def save_ui_lang(code: str) -> bool:
    """Persists the language choice and applies it; False when OMAYT_LANG overrides it."""
    global APP_LANG, APP_LANG_SOURCE
    if code not in UI_LANGS:
        return False
    settings = _read_settings()
    settings["lang"] = code
    try:
        SETTINGS_FILE.parent.mkdir(parents=True, exist_ok=True)
        SETTINGS_FILE.write_text(
            json.dumps(settings, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
        )
    except OSError:
        pass
    env = _env_ui_lang()
    if env:
        APP_LANG, APP_LANG_SOURCE = env, "env"
        return False
    APP_LANG, APP_LANG_SOURCE = code, "settings"
    return True


