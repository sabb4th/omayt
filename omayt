def _char_display_width(ch: str) -> int:
    cp = ord(ch)
    if cp < 32 or cp == 127:
        return 0
    if unicodedata.combining(ch):
        return 0
    # Nerd Font Private Use Area glyphs take 1 cell in Foot/Kitty/Ghostty
    if (0xE000 <= cp <= 0xF8FF) or (0xF0000 <= cp <= 0xFFFFD) or (0x100000 <= cp <= 0x10FFFD):
        return 1
    if unicodedata.east_asian_width(ch) in ("F", "W"):
        return 2
    return 1


def visible_len(text: str) -> int:
    clean = _ANSI_RE.sub("", text)
    return sum(_char_display_width(ch) for ch in clean)


def truncate_plain(text: str, max_w: int) -> str:
    if max_w <= 0:
        return ""
    if visible_len(text) <= max_w:
        return text
    if max_w <= 3:
        return "." * max_w
    out: list[str] = []
    cur = 0
    limit = max_w - 1
    for ch in text:
        w = _char_display_width(ch)
        if cur + w > limit:
            break
        out.append(ch)
        cur += w
    return "".join(out) + "…"


def _format_bytes(size_bytes: int) -> str:
    val = float(max(0, size_bytes))
    for unit in ("B", "KB", "MB", "GB"):
        if val < 1024.0 or unit == "GB":
            return f"{val:.1f} {unit}" if unit != "B" else f"{int(val)} B"
        val /= 1024.0
    return "0 B"


def _get_cache_stats() -> tuple[int, int]:
    if not THUMBS_DIR.is_dir():
        return (0, 0)
    count = 0
    total = 0
    try:
        for entry in THUMBS_DIR.iterdir():
            if entry.is_file():
                count += 1
                total += entry.stat().st_size
    except OSError:
        pass
    return (count, total)


def _list_downloaded_files() -> list[Path]:
