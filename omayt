def _import_ytfzf_history_if_empty() -> None:
    """Imports existing ytfzf history on first run so the TUI starts populated."""
    if HISTORY_FILE.is_file():
        return
    ytfzf_hist = Path.home() / ".cache" / "ytfzf" / "watch_hist"
    if not ytfzf_hist.is_file():
        return
    try:
        raw = ytfzf_hist.read_text(encoding="utf-8", errors="ignore")
        decoder = json.JSONDecoder()
        pos = 0
        imported: list[dict[str, Any]] = []
        db = load_json_file(VIDEOS_DB_FILE, {})
        while pos < len(raw):
            while pos < len(raw) and raw[pos].isspace():
                pos += 1
            if pos >= len(raw):
                break
            obj, next_pos = decoder.raw_decode(raw, pos)
            pos = next_pos
            if isinstance(obj, list):
                for item in obj:
                    if isinstance(item, dict) and item.get("ID"):
                        vid = str(item["ID"])
                        v_obj = {
                            "id": vid,
                            "title": item.get("title") or vid,
                            "channel": item.get("channel") or "YouTube",
                            "duration": item.get("duration") or "—",
                            "views": format_views(item.get("views")),
                            "url": f"https://www.youtube.com/watch?v={vid}",
                            "thumb_url": f"https://i.ytimg.com/vi/{vid}/maxresdefault.jpg",
                            "description": item.get("description") or "",
                            "watched_at": item.get("viewed") or "",
                        }
                        imported.insert(0, v_obj)
                        db[vid] = v_obj
        if imported:
            save_json_file(HISTORY_FILE, imported)
            save_json_file(VIDEOS_DB_FILE, db)
    except Exception:
        pass


def ensure_global_ytdlp_fix() -> bool:
    """Ensures ~/.config/yt-dlp/config and ~/.config/mpv/mpv.conf are optimized."""
    base_cfg = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    ytdlp_cfg_dir = base_cfg / "yt-dlp"
    ytdlp_cfg = ytdlp_cfg_dir / "config"
    fix_line = '--extractor-args "youtube:player_client=default,-tv_samsung"'
    codec_line = '-S "vcodec:h264,vp9"'
    try:
        ytdlp_cfg_dir.mkdir(parents=True, exist_ok=True)
        existing = ytdlp_cfg.read_text(encoding="utf-8") if ytdlp_cfg.is_file() else ""
        with ytdlp_cfg.open("a", encoding="utf-8") as f:
            if "-tv_samsung" not in existing:
                if existing and not existing.endswith("\n"):
                    f.write("\n")
                f.write(f"# Added by omayt to avoid 403 ad blocks on the tv_samsung client\n{fix_line}\n")
            if "vcodec:h264,vp9" not in existing:
                f.write(f"# Prioritize hardware-accelerated codecs (H.264/VP9)\n{codec_line}\n")

        mpv_cfg_dir = base_cfg / "mpv"
        mpv_cfg = mpv_cfg_dir / "mpv.conf"
        mpv_cfg_dir.mkdir(parents=True, exist_ok=True)
        mpv_existing = mpv_cfg.read_text(encoding="utf-8") if mpv_cfg.is_file() else ""
        if "hwdec=" not in mpv_existing:
            with mpv_cfg.open("a", encoding="utf-8") as f:
                if mpv_existing and not mpv_existing.endswith("\n"):
                    f.write("\n")
                f.write("# VA-API hardware acceleration (avoids Vulkan Video VK_KHR_video_decode_queue failure)\nhwdec=vaapi,vaapi-copy\n")
        return True
    except OSError:
        return False


def ensure_ytdl_wrapper() -> Path:
    """Creates the executable wrapper used by mpv's ytdl_hook."""
    script_path = Path(__file__).resolve()
    wrapper_code = f"""#!/usr/bin/env bash
exec python3 "{script_path}" --internal-ytdl-hook "$@"
"""
    try:
        if not YTDL_WRAPPER_PATH.is_file() or YTDL_WRAPPER_PATH.read_text(encoding="utf-8") != wrapper_code:
            YTDL_WRAPPER_PATH.write_text(wrapper_code, encoding="utf-8")
        YTDL_WRAPPER_PATH.chmod(0o755)
    except OSError:
        pass
    return YTDL_WRAPPER_PATH


def run_ytdl_hook_wrapper(args: list[str]) -> int:
    """
    yt-dlp interceptor for mpv:
    - Injects `--extractor-args youtube:player_client=default,-tv_samsung`
    - Prioritizes H.264 and VP9 codecs (`-S vcodec:h264,vp9`)
    - If YouTube requires an ad wait (`available_at`), waits with a
      countdown bar in the terminal before returning the JSON to mpv.
    """
    cmd = [YTDLP_BIN]
    if "--version" not in args:
        cmd.extend(["--extractor-args", EXTRACTOR_ARGS_CLI, "-S", "vcodec:h264,vp9"])
    cmd.extend(args)

    proc = subprocess.run(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        env=_subproc_env(),
    )
    if proc.stderr:
        sys.stderr.write(proc.stderr)

    out = proc.stdout
    if proc.returncode == 0 and out.lstrip().startswith("{"):
        try:
            data = json.loads(out)
            avail_times: list[float] = []
            if isinstance(data.get("available_at"), (int, float)):
                avail_times.append(float(data["available_at"]))
            for key in ("requested_formats", "formats"):
                fmt_list = data.get(key)
                if isinstance(fmt_list, list):
                    for f in fmt_list:
                        if isinstance(f, dict) and isinstance(f.get("available_at"), (int, float)):
                            avail_times.append(float(f["available_at"]))

            if avail_times:
                max_avail = max(avail_times)
                now = time.time()
                if max_avail > now:
                    wait_total = max_avail - now + 0.4
                    _show_ad_wait_countdown(wait_total)
        except Exception:
            pass

    sys.stdout.write(out)
    sys.stdout.flush()
    return proc.returncode


def _show_ad_wait_countdown(seconds: float) -> None:
    """Shows a countdown when YouTube requires waiting out the ad time."""
    c_warn = THEME.ansi_fg("yellow", bold=True)
    c_acc = THEME.ansi_fg("accent", bold=True)
    rst = THEME.reset
    end_time = time.time() + seconds
    try:
        tty_f = open("/dev/tty", "w", encoding="utf-8")
    except OSError:
        tty_f = sys.stderr

    try:
        while True:
            rem = end_time - time.time()
            if rem <= 0:
                break
            tty_f.write(
                f"\r  {c_warn}⏳ [omayt]{rst} "
                f"{tr('Waiting for YouTube ad release:', 'Attente de la fin de la publicité YouTube :', 'Aguardando a liberação do anúncio do YouTube:')} "
                f"{c_acc}{rem:0.1f}s{rst} {tr('remaining...', 'restantes...', 'restantes...')}   "
            )
            tty_f.flush()
            time.sleep(min(0.1, rem))
        released = tr("Stream released! Starting playback...", "Flux libéré ! Démarrage de la lecture...", 'Stream liberado! Iniciando a reprodução...')
        tty_f.write(f"\r  {THEME.ansi_fg('green', bold=True)}✓ [omayt]{rst} {released}                  \n")
        tty_f.flush()
    finally:
        if tty_f is not sys.stderr:
            tty_f.close()


def load_json_file(path: Path, default: Any) -> Any:
    if not path.is_file():
        return default
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return default


def save_json_file(path: Path, data: Any) -> None:
    try:
        tmp = path.with_suffix(f".tmp.{os.getpid()}")
        tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")
        os.replace(tmp, path)
    except OSError:
        pass


