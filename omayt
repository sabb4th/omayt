def format_tui_rows(
    videos: list[dict[str, Any]],
    header_note: str = "",
    can_load_more: bool = False,
    page_size: int = SEARCH_PAGE_SIZE,
) -> str:
    c_acc = THEME.ansi_fg("accent", bold=True)
    c_fg = THEME.ansi_fg("foreground")
    c_yel = THEME.ansi_fg("yellow", bold=True)
    c_grn = THEME.ansi_fg("green")
    c_mag = THEME.ansi_fg("magenta")
    c_mut = THEME.ansi_fg("muted")
    c_cyn = THEME.ansi_fg("cyan", bold=True)
    rst = THEME.reset

    lines: list[str] = []

    search_hint = (
        f" ({header_note})"
        if header_note
        else tr(
            " (Type above and press Enter or Ctrl+S)",
            " (Saisissez un terme ci-dessus puis Entrée ou Ctrl+S)", ' (Digite acima e pressione Enter ou Ctrl+S)',
        )
    )
    lines.append(
        f"__SEARCH__\t{c_cyn}  "
        f"{tr('[Search YouTube for the text typed above]', '[Rechercher sur YouTube le texte saisi ci-dessus]', '[Buscar no YouTube o texto digitado acima]')}"
        f"{rst}{c_mut}{search_hint}{rst}"
    )

    for idx, v in enumerate(videos, 1):
        vid = v.get("id", "")
        title = localize_video_title(v.get("title"), vid)
        if len(title) > 52:
            title = title[:49] + "..."
        channel = v.get("channel", "YouTube")
        if len(channel) > 18:
            channel = channel[:16] + ".."
        dur = localize_duration(v.get("duration", "??:??"), v.get("duration_raw"))
        views = localize_views(v.get("views", "—"), v.get("views_raw"))

        row = (
            f"{vid}\t"
            f"{c_mut}{idx:02d}.{rst} "
            f"{c_fg}{title:<52}{rst} "
            f"{c_yel}[{dur:>7}]{rst} "
            f"{c_grn}󰠃 {channel:<18}{rst} "
            f"{c_mag}󰈈 {views:>6}{rst}"
        )
        lines.append(row)

    if videos and can_load_more:
        more_txt = tr(
            f"[Load {page_size} more results]",
            f"[Charger {page_size} résultats de plus]",
            f"[Carregar mais {page_size} resultados]",
        )
        more_hint = tr("Enter here or Alt+M / Ctrl+E", "Entrée ici ou Alt+M / Ctrl+E", 'Enter aqui ou Alt+M / Ctrl+E')
        more_loaded = tr("loaded", "chargées", 'carregados')
        lines.append(
            f"__MORE__\t{c_cyn}󰐕  {more_txt}{rst}"
            f"{c_mut} ({more_hint} • {len(videos)} {more_loaded}){rst}"
        )

    if not videos:
        lines.append(
            f"__HISTORY__\t{c_acc}󰋚  "
            f"{tr('[No videos loaded — type your search above and press Enter or Ctrl+S]', '[Aucune vidéo chargée — saisissez une recherche ci-dessus puis Entrée ou Ctrl+S]', '[Nenhum vídeo carregado — digite sua busca acima e pressione Enter ou Ctrl+S]')}{rst}"
        )

    return "\n".join(lines)


